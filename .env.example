# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
# Found in Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Server-side service role key (recommended for API route inserts if RLS restricts anon)
# Keep this secret and never expose it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
