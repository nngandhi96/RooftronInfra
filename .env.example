# Supabase Configuration
# Copy this file to .env.local for local dev, and add these variables in
# Vercel -> Project Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Server-side service role key (used only by /api/boq-inquiries on the server)
# Keep this secret and never expose it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
